# Postgres (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/okoume?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/okoume?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Public URL of the site (https://okoume.onrender.com in production)
BETTER_AUTH_URL=http://localhost:3000

# Email: without a key, emails are only stored in the outbox table (demo mode shows them)
RESEND_API_KEY=
MAIL_FROM="Okoumé <onboarding@resend.dev>"

# Demo mode: shows demo accounts and the demo outbox page. Turn off for a real launch.
DEMO_MODE=1

# Protects POST /api/cron/daily (called once a day by .github/workflows/daily.yml). At least 16 characters.
CRON_SECRET=change-me-at-least-16-chars

# The one header your host's proxy sets with the visitor's IP (used by auth rate limits). Check it on Render before launch.
TRUSTED_IP_HEADER=x-forwarded-for

# Password given to the demo accounts by `npm run db:seed` (keep it private)
SEED_PASSWORD=
